# CONTOH FORMAT (BUKAN SARAN INVESTASI). Item 13 SPEC §24.
# Salin isi berkas ini ke berkas bernama tepat ".env" (BUKAN ".env.txt") di folder utama proyek,
# di sebelah config.yaml, lalu ganti kedua nilai dengan milik Anda. Jangan bagikan berkas .env ke siapa pun.
#
# TELEGRAM_BOT_TOKEN: token dari @BotFather setelah perintah /newbot. Bentuknya angka, titik dua, lalu teks.
# TELEGRAM_CHAT_ID  : ID chat Anda (angka). Kirim satu pesan apa pun ke bot Anda, lalu jalankan
#                     ".venv\Scripts\python -m asisten_bei uji-telegram --cari-chat-id" (SPEC §19.4; perintah ini
#                     tersedia mulai tahap 7, bersama notifikasi Telegram).
# Tanpa spasi di sekitar "=" dan tanpa tanda kutip. Nilai di bawah FIKTIF dan tidak akan berfungsi.
TELEGRAM_BOT_TOKEN=123456789:CONTOH_FIKTIF_ganti_dengan_token_dari_BotFather
TELEGRAM_CHAT_ID=987654321
